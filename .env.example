# Copy this file to .env in the repo root. .env is git-ignored; never commit real values.

# Claude API key for the agent's model calls. Needed from M1; nothing reads it yet.
ANTHROPIC_API_KEY=

# Optional: Shopify CLI token for non-interactive Partner access (from M1).
# Leave empty to sign in with `shopify auth login` instead.
SHOPIFY_CLI_PARTNERS_TOKEN=

# Optional: where generated apps are written. Defaults to ./workspace
# AGENT_WORKSPACE=
