# Copy this file to .env in the repo root. .env is git-ignored; never commit real values.

# Required: Claude API key for writing the architecture and building the app.
ANTHROPIC_API_KEY=

# Optional: most Claude may spend on one step, in US dollars (default 10).
# AGENT_MAX_BUDGET_USD=10

# Optional: where generated apps are written. Defaults to ./workspace
# AGENT_WORKSPACE=
